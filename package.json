{
  "name": "@agent-qofeno/demotion",
  "version": "0.0.0",
  "description": "Motion graphics, written in code. A React toolkit and CLI for making polished videos locally with Remotion: beat-synced motion, camera, type, transitions and sound. Free for personal use; commercial license available.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Qofeno Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohailkhan0525/demotion.git"
  },
  "homepage": "https://github.com/sohailkhan0525/demotion#readme",
  "bugs": {
    "url": "https://github.com/sohailkhan0525/demotion/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/types/lib-three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "bin": {
    "demotion": "./bin/demotion.js"
  },
  "files": [
    "dist",
    "bin",
    "template",
    "public/fonts",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "remotionVersion": "4.0.528"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/demotion.mp4",
    "render:4k": "remotion render src/index.ts Demo out/demotion-4k.mp4 --scale=2",
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "remotion",
    "video",
    "motion-graphics",
    "react",
    "programmatic-video",
    "demo-video",
    "animation"
  ],
  "peerDependencies": {
    "@remotion/fonts": "^4.0.0",
    "@remotion/noise": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@remotion/cli": "4.0.528",
    "@remotion/fonts": "^4.0.528",
    "@remotion/layout-utils": "^4.0.528",
    "@remotion/noise": "^4.0.528",
    "@remotion/three": "^4.0.528",
    "@remotion/transitions": "^4.0.528",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "esbuild": "^0.25.0",
    "postprocessing": "^6.36.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "4.0.528",
    "semantic-release": "^24.2.9",
    "three": "^0.160.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/qofenoai"
  }
}